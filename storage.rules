rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // Function to check if user is admin (assumes custom claims or client-enforced if no claims exist)
    // Since Storage rules cannot read Firestore documents directly easily without custom claims, 
    // a common pattern is to allow authenticated users to upload, or rely on admin SDKs.
    
    match /{allPaths=**} {
      // Anyone can view product images or files
      allow read: if true;
      
      // Only authenticated users can upload (or admins). 
      // Note: If only admins should upload, it's best done via the Admin SDK which bypasses rules,
      // or you must set custom claims `request.auth.token.admin == true`
      allow write: if request.auth != null;
    }
  }
}
